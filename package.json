{
  "name": "dsh-neu-theme",
  "version": "0.2.0",
  "description": "Neumorphism soft-UI theme for DeepSeek Harness Web and its embedded Desktop workspace — gentle raised-and-recessed surfaces in a cream light and an ink-dark palette. · DeepSeek Harness Web 与桌面工作区轻拟物主题：柔和浮起与凹陷，奶油浅色与墨蓝深色两套配色。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "themes",
    "README.md",
    ".github/asset/*.webp",
    ".github/asset/dsh-neu-theme-hero.png",
    "LICENSE",
    "README.zh.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "theme",
    "skin",
    "neumorphism",
    "soft-ui",
    "web-ui",
    "desktop"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/index.js && node --check src/client.tpl.js && node --check lib/client.js && node --check lib/index.js && node scripts/check-compat.mjs"
  },
  "author": "Lhy723",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lhy723/dsh-neu-theme.git"
  },
  "homepage": "https://github.com/Lhy723/dsh-neu-theme",
  "bugs": {
    "url": "https://github.com/Lhy723/dsh-neu-theme/issues"
  },
  "engines": {
    "dsh": "^0.2.0-rc.2"
  }
}
